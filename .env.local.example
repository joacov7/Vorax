# Copiá este archivo como .env.local y completá los valores.
# Los marcados con *** son OBLIGATORIOS para arrancar.

# *** DATABASE (Neon) ***
# Conseguilo en: neon.tech > tu proyecto > Dashboard > Connection string
# Elegí el formato: "Nodejs" y copiá la URL completa
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# *** AUTH (Clerk) ***
# Conseguilo en: dashboard.clerk.com > tu app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# *** AI (Anthropic) ***
# Conseguilo en: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxx

# *** AI (OpenAI) — para embeddings ***
# Conseguilo en: platform.openai.com > API Keys
OPENAI_API_KEY=sk-xxx

# *** CACHE / QUEUE (Upstash Redis) ***
# Conseguilo en: console.upstash.com > Redis > tu database > REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXxxx

# EMAIL (Resend) — opcional para MVP
# Conseguilo en: resend.com > API Keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@tudominio.com

# WHATSAPP (Evolution API) — opcional para MVP
EVOLUTION_API_URL=https://evolution.tuservidor.com
EVOLUTION_API_KEY=xxx

# STORAGE (Cloudflare R2) — opcional para MVP
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=empresa-ia
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# PAYMENTS (MercadoPago) — opcional para MVP
MP_ACCESS_TOKEN=APP_USR-xxx
MP_PUBLIC_KEY=APP_USR-xxx
MP_WEBHOOK_SECRET=xxx

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
WEBHOOK_SECRET=cualquier_string_random_aqui
